{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Todo",
  "version": "0.1.18",
  "identifier": "com.creek.googletodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Google Todo",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MUM4MDhEQzJCRDFEODcKUldTSEhiM0NqWUFjTlF5eEdIelRsZTZWL2dMZVhqWWpTOFJSaUhPNkV6c3RnYlhXYkJXeUN1NWYK",
      "endpoints": [
        "https://raw.githubusercontent.com/CreekCai/GoogleTodo/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
